#!/bin/sh
export PATH="/Users/yskjha/.local/node/bin:$PATH"

echo "🔍 Running pre-commit verification..."

# 1. Type checking
echo "  → Checking TypeScript types..."
npm run type-check || { echo "❌ TypeScript compilation failed!"; exit 1; }

# 2. Lint staged files
echo "  → Linting staged files..."
npx lint-staged || { echo "❌ Lint checks failed!"; exit 1; }

# 3. Privacy check (ensure confidential phone number is not exposed in public source markup)
if git diff --cached -- ':!.husky/*' | grep -E "\+91[ -]?[0-9]{10}" > /dev/null 2>&1; then
  echo "❌ Error: Confidential phone number pattern detected in staged source! Phone must only be in resume PDF, never web markup."
  exit 1
fi

echo "✅ Pre-commit verification passed successfully."
